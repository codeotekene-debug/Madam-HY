# ==============================================================================
# MADAM HY SMART SHOP — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.production on your production server.
# Ensure strict file permissions (chmod 600 .env.production).

# ------------------------------------------------------------------------------
# CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production, SECRET_KEY MUST be a cryptographically random string of at least 50 chars.
# Generate one on Linux with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-very-long-and-secure-random-secret-key-min-50-characters

# DEBUG MUST ALWAYS BE FALSE IN PRODUCTION
DEBUG=False

# Comma-separated list of fully qualified domain names and server IP addresses
# Wildcard '*' is strictly prohibited when DEBUG=False.
ALLOWED_HOSTS=smartshop.example.com,app.smartshop.ng,127.0.0.1,localhost

# ------------------------------------------------------------------------------
# PRODUCTION DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
DB_ENGINE=mysql
DB_NAME=madam_hy
DB_USER=madam_user
DB_PASSWORD=choose-a-strong-database-password-here
DB_HOST=127.0.0.1
DB_PORT=3306
DB_ROOT_PASSWORD=choose-a-strong-mysql-root-password-here

# Persistent database connections (seconds). Closes after max age.
CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# PRODUCTION SECURITY HEADERS & COOKIES
# ------------------------------------------------------------------------------
# Redirect all non-HTTPS HTTP traffic to HTTPS
SECURE_SSL_REDIRECT=True

# Transmit session and CSRF cookies only over HTTPS
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) — 1 Year (31536000 seconds)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Browser client protection flags
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY

# Reverse proxy SSL header forwarding (Required behind Nginx / Cloudflare / ALB)
SECURE_PROXY_SSL_HEADER=True

# ------------------------------------------------------------------------------
# PAYMENT GATEWAYS (LIVE PRODUCTION CREDENTIALS)
# ------------------------------------------------------------------------------
# Paystack Live Keys: https://dashboard.paystack.com/#/settings/developers
PAYSTACK_SECRET_KEY=sk_live_change_me_to_your_live_secret_key
PAYSTACK_PUBLIC_KEY=pk_live_change_me_to_your_live_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# Moniepoint POS Terminal Live Integration
# Method A: Direct API Key Authentication (Default for https://api.pos.moniepoint.com)
# Generated from live Moniepoint Business Dashboard > Settings > POS Apps Developer.
MONIEPOINT_API_KEY=your_production_moniepoint_api_key
# Hardware serial number of the in-store physical POS terminal
MONIEPOINT_TERMINAL_ID=your_production_terminal_hardware_serial
MONIEPOINT_BASE_URL=https://api.pos.moniepoint.com

# Method B: OAuth Client Credentials (If using partner ERP channel integration https://channel.moniepoint.com)
# MONIEPOINT_AUTH_METHOD=CLIENT_CREDENTIALS
# MONIEPOINT_CLIENT_ID=your_production_client_id
# MONIEPOINT_CLIENT_SECRET=your_production_client_secret
MONIEPOINT_SECRET_KEY=your_production_moniepoint_secret_key

# In-store counter transfer details
MONIEPOINT_COUNTER_ACCOUNT=your_moniepoint_counter_account_number
MONIEPOINT_BANK_NAME=Moniepoint MFB
MONIEPOINT_TIMEOUT=15

