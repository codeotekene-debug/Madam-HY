# ==============================================================================
# SMART SHOP / MADAM HY — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure appropriate values for your deployment environment.
# In production, ensure DEBUG=False, provide a strong SECRET_KEY (>= 50 characters),
# and define explicit ALLOWED_HOSTS (wildcards '*' are strictly disallowed).

# ------------------------------------------------------------------------------
# CORE DJANGO SETTINGS
# ------------------------------------------------------------------------------
# In production (DEBUG=False), SECRET_KEY MUST be a random string >= 50 characters
# with sufficient entropy (at least 5 unique characters). Insecure defaults, keys
# shorter than 50 characters, or keys prefixed with 'django-insecure-' will be rejected
# with ImproperlyConfigured.
# Generate a new production key with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-random-secret-key-before-use

# Set to True for local development; strictly False in staging and production.
# Defaults to False if omitted or invalid.
DEBUG=False

# Comma-separated list of valid domain names or IP addresses for this deployment.
# Wildcard '*' and empty values are disallowed when DEBUG=False.
ALLOWED_HOSTS=smartshop.example.com,app.smartshop.ng,127.0.0.1,localhost

# ------------------------------------------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# Option A: Full Connection URL (takes precedence if provided)
# Examples:
#   DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/madam_hy
#   DATABASE_URL=sqlite:///db.sqlite3
#   DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/madam_hy
# DATABASE_URL=

# Option B: Individual database parameters
# Set DB_ENGINE to 'mysql', 'postgresql', or 'sqlite' (defaults to 'sqlite' if unspecified)
DB_ENGINE=mysql
DB_NAME=madam_hy
DB_USER=madam_user
DB_PASSWORD=strong_password
DB_HOST=127.0.0.1
DB_PORT=3306

# Persistent database connections (seconds). Default is 0 (close after each request).
# Recommended for production: 60 to 300 seconds.
CONN_MAX_AGE=60

# ------------------------------------------------------------------------------
# PRODUCTION SECURITY HEADERS & COOKIES
# ------------------------------------------------------------------------------
# In production (DEBUG=False), these settings automatically activate safe defaults.
# You can override them using the environment variables below if needed.

# Redirect all non-HTTPS requests to HTTPS (default: True when DEBUG=False, False when DEBUG=True)
SECURE_SSL_REDIRECT=True

# Transmit session and CSRF cookies only over secure HTTPS connections (default: True when DEBUG=False)
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# HTTP Strict Transport Security (HSTS) settings (defaults: 31536000 [1 year], True, True when DEBUG=False)
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# Browser security protections
# Enables X-Content-Type-Options: nosniff
SECURE_CONTENT_TYPE_NOSNIFF=True
# Enables X-XSS-Protection: 1; mode=block
SECURE_BROWSER_XSS_FILTER=True
# Prevents clickjacking by denying framing (options: DENY, SAMEORIGIN)
X_FRAME_OPTIONS=DENY

# Reverse proxy SSL header forwarding
# Set to True (or HTTP_X_FORWARDED_PROTO,https) when hosted behind Nginx, Cloudflare,
# AWS ALB, or Render terminating SSL.
# WARNING: Do NOT enable unless behind a verified reverse proxy.
# SECURE_PROXY_SSL_HEADER=True

# ------------------------------------------------------------------------------
# LOGGING CONFIGURATION
# ------------------------------------------------------------------------------
# Application logs are written to console (StreamHandler) and rotated in logs/smart_shop.log
# (RotatingFileHandler: maxBytes 10MB, 5 backups). Security events are logged to django.security.

# ------------------------------------------------------------------------------
# PAYMENT GATEWAYS & RECONCILIATION PROVIDERS
# ------------------------------------------------------------------------------
# Paystack (Phase 4A: Online payment verification & reconciliation)
# Secret key is required for server-side verification: https://api.paystack.co/transaction/verify/{ref}
PAYSTACK_SECRET_KEY=sk_test_placeholder_key_for_development
PAYSTACK_PUBLIC_KEY=pk_test_placeholder_key_for_development
PAYSTACK_BASE_URL=https://api.paystack.co

# Moniepoint POS Terminal Integration & In-Store Counter Transfer
# Method A: Direct API Key Authentication (Default for https://api.pos.moniepoint.com)
# Generated from Moniepoint Business Dashboard: Settings > POS Apps Developer.
MONIEPOINT_API_KEY=
# Terminal Hardware Serial Number (e.g., printed on back of physical POS terminal or under POS Terminal Configuration)
# IMPORTANT: This must be the actual device hardware serial number, NOT an API client ID.
MONIEPOINT_TERMINAL_ID=
MONIEPOINT_BASE_URL=https://api.pos.moniepoint.com

# Method B: OAuth Client Credentials Authentication (For https://channel.moniepoint.com or partner ERP flows)
# MONIEPOINT_AUTH_METHOD=CLIENT_CREDENTIALS
# MONIEPOINT_CLIENT_ID=api-client-xxxx
# MONIEPOINT_CLIENT_SECRET=xxxx
MONIEPOINT_SECRET_KEY=

# In-store counter direct transfer details
MONIEPOINT_COUNTER_ACCOUNT=
MONIEPOINT_BANK_NAME=Moniepoint MFB
MONIEPOINT_TIMEOUT=15
